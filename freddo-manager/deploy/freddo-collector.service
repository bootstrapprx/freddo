[Unit]
Description=freddo-manager Collector (telemetria e alertas)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=freddo-collector
Group=freddo-collector
SupplementaryGroups=docker freddo-manager
EnvironmentFile=/etc/freddo-manager/collector.env
WorkingDirectory=/opt/freddo-manager
ExecStart=/opt/freddo-manager/.venv/bin/freddo-manager collector
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
ProtectSystem=strict
ReadWritePaths=/var/lib/freddo-manager
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
