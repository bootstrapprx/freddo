# Copie para .env e ajuste. Nunca comite credenciais.
FREDDO_HOME=/var/lib/freddo-manager
FREDDO_FM_BIN=fmx
# Opcional: sobrescreve o caminho escolhido no `freddo-manager configure`.
# FREDDO_FM_HOME=/home/freddo/frappe

# auto | docker | podman. Em Podman, use o socket do usuario dono dos benches:
# FREDDO_CONTAINER_RUNTIME=podman
# FREDDO_DOCKER_SOCKET=/var/run/docker.sock
# FREDDO_PODMAN_SOCKET=/run/user/1000/podman/podman.sock
# XDG_RUNTIME_DIR=/run/user/1000

# API: sem acesso ao Docker; o Executor faz todo o trabalho privilegiado.
FREDDO_EMBED_EXECUTOR=0
FREDDO_API_HOST=127.0.0.1
FREDDO_API_PORT=8710
FREDDO_PUBLIC_ORIGIN=https://console.example.com
FREDDO_CORS_ORIGINS=["https://console.example.com"]

# SO_PEERCRED: uid/gid autorizados a falar com o Executor (conta da API).
FREDDO_EXECUTOR_UID=1001
FREDDO_EXECUTOR_GID=1001

# Token do tunnel remote-managed, usado apenas pelo Compose local.
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Access (defesa em profundidade).
FREDDO_REQUIRE_CLOUDFLARE_JWT=1
FREDDO_CLOUDFLARE_ACCESS_TEAM=example
FREDDO_CLOUDFLARE_ACCESS_AUD=https://console.example.com

# Sessao e step-up
FREDDO_SESSION_IDLE_MINUTES=30
FREDDO_SESSION_ABSOLUTE_HOURS=12
FREDDO_STEPUP_MINUTES=5

# Telemetria / alertas
FREDDO_COLLECT_INTERVAL_SECONDS=15
FREDDO_ALERT_WEBHOOK_URL=
FREDDO_TELEGRAM_TOKEN=
FREDDO_TELEGRAM_CHAT=

# Terminal web (desligado por padrao; exige step-up e sessao gravada):
# FREDDO_ENABLE_SHELL=1
