{
  "type": "object",
  "name": "FmxDeployment",
  "properties": {
    "bench_id": {
      "type": "string",
      "description": "Bench alvo da execu\u00e7\u00e3o"
    },
    "bench_name": {
      "type": "string",
      "description": "Nome do bench para leitura r\u00e1pida"
    },
    "kind": {
      "type": "string",
      "enum": [
        "build",
        "migrate",
        "deploy",
        "backup"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "gray"
      ],
      "default": "migrate"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "running"
      ],
      "enumColors": [
        "green",
        "red",
        "yellow"
      ],
      "default": "running"
    },
    "duration_s": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em segundos"
    },
    "summary": {
      "type": "string",
      "description": "Resumo de uma linha da execu\u00e7\u00e3o"
    }
  },
  "required": [
    "bench_id",
    "kind"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}