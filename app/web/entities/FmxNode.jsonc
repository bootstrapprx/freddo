{
  "type": "object",
  "name": "FmxNode",
  "properties": {
    "name": {
      "type": "string",
      "description": "Identificador curto do VPS (ex: atlas-01)"
    },
    "ip": {
      "type": "string",
      "description": "IP p\u00fablico do node"
    },
    "provider": {
      "type": "string",
      "description": "Provedor da VPS"
    },
    "region": {
      "type": "string",
      "description": "Regi\u00e3o / datacenter"
    },
    "vcpu": {
      "type": "number",
      "description": "vCPUs totais"
    },
    "ram_gb": {
      "type": "number",
      "description": "RAM total em GB"
    },
    "monthly_cost": {
      "type": "number",
      "description": "Custo fixo mensal da VPS"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "BRL"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow"
      ],
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "degraded",
        "offline"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "online"
    },
    "ssh_user": {
      "type": "string",
      "description": "Usu\u00e1rio SSH usado pelo daemon"
    }
  },
  "required": [
    "name",
    "ip",
    "monthly_cost"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}