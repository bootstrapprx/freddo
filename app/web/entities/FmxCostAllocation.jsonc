{
  "type": "object",
  "name": "FmxCostAllocation",
  "properties": {
    "bench_id": {
      "type": "string",
      "description": "Bench que consumiu o recurso"
    },
    "node_id": {
      "type": "string",
      "description": "Node onde o bench roda"
    },
    "date": {
      "type": "string",
      "description": "Dia da aloca\u00e7\u00e3o (YYYY-MM-DD)"
    },
    "cpu_pct": {
      "type": "number",
      "description": "CPU m\u00e9dia do dia em % do node"
    },
    "ram_pct": {
      "type": "number",
      "description": "RAM m\u00e9dia do dia em % do node"
    },
    "allocated_cost": {
      "type": "number",
      "description": "Custo proporcional alocado no dia"
    }
  },
  "required": [
    "bench_id",
    "date",
    "allocated_cost"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}